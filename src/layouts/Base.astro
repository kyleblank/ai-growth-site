---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "严博远的个人 AI 学习成长数字基地" } = Astro.props;

const nav = [
  { href: "/", label: "首页" },
  { href: "/monitor/", label: "博主监控" },
  { href: "/path/", label: "学习路径" },
  { href: "/notes/", label: "学习笔记" },
  { href: "/resources/", label: "资源导航" },
  { href: "/career/", label: "职场AI" },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href.replace(/\/$/, ""));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · 严博远AI成长录</title>
  </head>
  <body class="min-h-screen bg-ink text-txt">
    <header class="sticky top-0 z-10 border-b border-line bg-ink/85 backdrop-blur">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-wide">
          <span class="text-accent">严博远</span><span>AI成长录</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "transition-colors hover:text-accent",
                isActive(item.href) ? "text-accent" : "text-dim",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-line py-6 text-center text-xs text-dim">
      严博远AI成长录 · 数据为手动/脚本采集的真实公开数据 · 筛选规则：收藏率门槛 + 相对热度分
    </footer>
  </body>
</html>
