---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtDate } from "../../lib/format";
import { sitePath } from "../../lib/site";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title}>
  <article class="mx-auto max-w-3xl">
    <div class="mb-8">
      <a href={sitePath("/notes/")} class="text-sm text-accent hover:underline">← 返回笔记列表</a>
      <h1 class="mt-4 text-3xl font-bold">{note.data.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-dim">
        <span class={note.data.status === "done" ? "text-good" : "text-mid"}>
          {note.data.status === "done" ? "● 已完成" : "● 学习中"}
        </span>
        <span>·</span>
        <span>{fmtDate(note.data.date.toISOString().slice(0, 10))}</span>
        {note.data.tags.map((t) => (
          <span class="rounded-full border border-line px-2 py-0.5">{t}</span>
        ))}
      </div>
      {note.data.source && (
        <a
          href={note.data.source}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-block rounded-lg border border-line px-3 py-1.5 text-xs text-dim transition-colors hover:border-accent/60 hover:text-accent"
        >
          📺 内容来源 ↗
        </a>
      )}
    </div>

    <div
      class="prose-invert max-w-none leading-relaxed
             [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-txt
             [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-bold
             [&_p]:my-3 [&_li]:my-1 [&_a]:text-accent [&_a]:underline
             [&_code]:rounded [&_code]:bg-panel-2 [&_code]:px-1 [&_code]:font-mono [&_code]:text-sm
             [&_blockquote]:border-l-2 [&_blockquote]:border-accent/50 [&_blockquote]:pl-4 [&_blockquote]:text-dim
             [&_blockquote]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6
             [&_strong]:text-txt"
    >
      <Content />
    </div>
  </article>
</Base>
