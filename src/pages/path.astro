---
import Base from "../layouts/Base.astro";

const phases = [
  {
    name: "阶段 0 · AI基础认知",
    period: "已完成",
    state: "done",
    items: ["了解大模型基本原理与能力边界", "注册并日常使用豆包/DeepSeek等主流工具"],
  },
  {
    name: "阶段 1 · 提示词与工具流",
    period: "进行中",
    state: "active",
    items: ["系统学习提示词工程", "搭建个人常用提示词库", "掌握豆包Agent等进阶玩法"],
  },
  {
    name: "阶段 2 · Agent与自动化",
    period: "待开始",
    state: "todo",
    items: ["入门 Claude Code / TRAE 等编程Agent", "用Agent自动生成HTML数据看板", "把重复工作交给Agent工作流"],
  },
  {
    name: "阶段 3 · AI深度应用",
    period: "待开始",
    state: "todo",
    items: ["本地模型部署（Hermes Agent等）", "多Agent协作场景实践", "沉淀可复用的职场AI方法论"],
  },
];

const stateStyle: Record<string, string> = {
  done: "border-good/40 text-good",
  active: "border-accent text-accent",
  todo: "border-line text-dim",
};
---

<Base title="学习路径">
  <div class="mb-8">
    <h1 class="text-2xl font-bold mb-2">🗺️ 学习路径</h1>
    <p class="text-sm text-dim">AI 学习成长时间线，按阶段推进，完成一项勾一项。</p>
  </div>

  <div class="relative pl-6">
    <div class="absolute left-1.5 top-2 bottom-2 w-px bg-line"></div>
    {phases.map((p) => (
      <div class={`relative mb-6 rounded-xl border bg-panel p-5 ${stateStyle[p.state]}`}>
        <div
          class={`absolute -left-[1.4rem] top-6 h-3 w-3 rounded-full border-2 ${
            p.state === "active" ? "border-accent bg-accent" : p.state === "done" ? "border-good bg-good/30" : "border-line bg-panel"
          }`}
        >
        </div>
        <div class="flex flex-wrap items-baseline gap-3 mb-3">
          <h2 class="font-bold text-txt">{p.name}</h2>
          <span class={`text-xs ${stateStyle[p.state]}`}>{p.period}</span>
        </div>
        <ul class="space-y-1.5 text-sm text-dim">
          {p.items.map((item) => (
            <li class="flex items-start gap-2">
              <span class={p.state === "done" ? "text-good" : "text-dim"}>
                {p.state === "done" ? "✓" : "○"}
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="text-xs text-dim">
    路径内容在 <code class="rounded bg-panel-2 px-1">src/pages/path.astro</code> 中维护，后续接入勾选进度记录。
  </p>
</Base>
