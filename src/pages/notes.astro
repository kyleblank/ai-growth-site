---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { fmtDate } from "../lib/format";
import { sitePath } from "../lib/site";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="学习笔记">
  <div class="mb-8">
    <h1 class="text-2xl font-bold mb-2">📝 学习笔记</h1>
    <p class="text-sm text-dim">
      在 <code class="rounded bg-panel-2 px-1">src/content/notes/</code> 下新建 Markdown 文件即自动成页。
    </p>
  </div>

  <div class="grid gap-4">
    {notes.map((note) => (
      <a
        href={sitePath(`/notes/${note.id}/`)}
        class="group rounded-xl border border-line bg-panel p-5 transition-colors hover:border-accent/60"
      >
        <div class="flex flex-wrap items-center gap-2 mb-2 text-xs text-dim">
          <span class={note.data.status === "done" ? "text-good" : "text-mid"}>
            {note.data.status === "done" ? "● 已完成" : "● 学习中"}
          </span>
          <span>·</span>
          <span>{fmtDate(note.data.date.toISOString().slice(0, 10))}</span>
          {note.data.tags.map((t) => (
            <span class="rounded-full border border-line px-2 py-0.5">{t}</span>
          ))}
        </div>
        <div class="text-lg font-bold group-hover:text-accent transition-colors">
          {note.data.title}
        </div>
        {note.body.trim().length > 0 && (
          <p class="mt-2 line-clamp-2 text-sm text-dim">
            {note.body.split("\n").find((l) => l.trim() && !l.startsWith("#"))?.replace(/^[>*-]\s*/, "") ?? ""}
          </p>
        )}
      </a>
    ))}
  </div>

  {notes.length === 0 && (
    <div class="rounded-xl border border-dashed border-line p-10 text-center text-dim">
      还没有笔记，去 src/content/notes/ 创建第一篇吧
    </div>
  )}
</Base>
